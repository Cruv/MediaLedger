# User/Group ID - match your host user to avoid permission issues
# Run `id` on your host to find your UID/GID
PUID=1000
PGID=1000

# Timezone - https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# PostgreSQL
DB_PASSWORD=changeme_strong_password

# Application
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
LOG_LEVEL=info
