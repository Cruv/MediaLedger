# ─── Docker User/Group ─────────────────────────────────────────────
# Match your host user to avoid permission issues. Run `id` to check.
PUID=1000
PGID=1000

# ─── Timezone ──────────────────────────────────────────────────────
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# ─── PostgreSQL ────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password

# ─── Application ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
LOG_LEVEL=info

# ─── Playback ─────────────────────────────────────────────────────
# Percentage watched to count as "completed" (default: 85)
# COMPLETION_THRESHOLD_PCT=85.0

# ─── GeoIP (optional) ─────────────────────────────────────────────
# Download GeoLite2-City.mmdb from MaxMind and place in config/data/
# GEOIP_DB_PATH=/config/data/GeoLite2-City.mmdb

# ─── Stripe Integration (optional) ────────────────────────────────
# Enable subscription-based user access management
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
